
// lib/ai.ts
// Simple wrapper around your LLM provider (e.g., OpenAI, Anthropic, etc.)

type CallLLMOptions = {
  model: string
  system: string
  user: string
}

export async function callLLM({ model, system, user }: CallLLMOptions) {
  // Example using OpenAI-compatible API; replace with your provider
  const res = await fetch('https://api.openai.com/v1/chat/completions', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      model,
      messages: [
        { role: 'system', content: system },
        { role: 'user', content: user },
      ],
      temperature: 0.3,
      max_tokens: 250,
    }),
  })

  if (!res.ok) {
    const text = await res.text()
    throw new Error(`LLM error: ${res.status} ${text}`)
  }

  const data = await res.json()
  return data.choices[0].message.content as string
}
