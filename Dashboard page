
'use client'

import { useState, useEffect } from 'react'
import { useSession } from 'next-auth/react'

// Simple types for MVP
type Transaction = {
  id: string
  amount: number
  currency: string
  date: string
  merchant: string | null
  category: string | null
}

type Task = {
  id: string
  title: string
  dueDate: string | null
  completed: boolean
}

type Subscription = {
  id: string
  merchant: string
  amount: number
  nextBillingDate: string | null
  isActive: boolean
}

