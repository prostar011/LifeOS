
// app/api/ai/chat/route.ts
import { NextRequest } from 'next/server'
import { currentUser } from '@/lib/auth'
import { db } from '@/lib/db'
import { callLLM } from '@/lib/ai'

export async function POST(req: NextRequest) {
  const user = await currentUser()
  if (!user) return new Response('Unauthorized', { status: 401 })

  const { prompt, context } = await req.json()
  if (!prompt || typeof prompt !== 'string') {
    return Response.json({ error: 'Invalid prompt' }, { status: 400 })
  }

  // Enforce daily AI usage limits based on plan
  const today = new Date()
  today.setHours(0, 0, 0, 0)
  const usageToday = await db.aiConversation.count({
    where: { userId: user.id, createdAt: { gte: today } },
  })

  const limit = user.plan === 'premium' ? 200 : 20
  if (usageToday >= limit) {
    return Response.json(
      { error: 'Daily AI limit reached', upgrade: true },
      { status: 429 }
    )
  }

  // Build a concise context summary for the LLM
  const recentTransactions = await db.transaction.findMany({
    where: { userId: user.id },
    orderBy: { date: 'desc' },
    take: 20,
  })

  const upcomingTasks = await db.task.findMany({
    where: { userId: user.id, completed: false },
    orderBy: { dueDate: 'asc' },
    take: 10,
  })

  const contextSummary = {
    plan: user.plan,
    recentTransactions: recentTransactions.map((t) => ({
      merchant: t.merchant,
      amount: t.amount,
      category: t.category,
      date: t.date,
    })),
    upcomingTasks: upcomingTasks.map((t) => ({
      title: t.title,
      dueDate: t.dueDate,
    })),
  }

  const systemPrompt = `
You are LifeOS AI, a friendly, concise personal assistant for money, tasks, and local essentials.
Guidelines:
- Respond in 1–4 sentences, optimized for being read aloud.
- Use everyday speech; avoid jargon.
- If the user asks about money, refer to recent transactions and spending patterns.
- If the user asks about tasks, help them prioritize and plan their day.
- If the user asks about local essentials, suggest nearby groceries, pharmacies, or gas.
- Never ask for sensitive data (full card numbers, passwords, SSN, etc.).
- If unsure, offer a simple next step (“Want me to show your recent transactions?”).

User context (summarized):
${JSON.stringify(contextSummary, null, 2)}
`

  const responseText = await callLLM({
    model: 'gpt-4.1-mini', // or your preferred model
    system: systemPrompt,
    user: prompt,
  })

  await db.aiConversation.create({
    data: {
      userId: user.id,
      prompt,
      response: responseText,
    },
  })

  return Response.json({ response: responseText })
}
