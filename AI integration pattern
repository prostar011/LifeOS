// app/api/ai/chat/route.ts
import { NextRequest } from 'next/server'
import { currentUser } from '@/lib/auth'
import { db } from '@/lib/db'
import { callLLM } from '@/lib/ai' // your LLM client wrapper

export async function POST(req: NextRequest) {
  const user = await currentUser()
  if (!user) return new Response('Unauthorized', { status: 401 })

  const { prompt, context } = await req.json()

  // Enforce usage limits based on plan
  const today = new Date()
  today.setHours(0,0,0,0)
  const usageToday = await db.aiConversation.count({
    where: { userId: user.id, createdAt: { gte: today } }
  })

  const limit = user.plan === 'premium' ? 200 : 20
  if (usageToday >= limit) {
    return Response.json({ error: 'Daily AI limit reached', upgrade: true }, { status: 429 })
  }

  const systemPrompt = `
You are LifeOS AI, a personal assistant for money, tasks, and local essentials.
Be concise, actionable, and privacy-aware. Never ask for sensitive data.
Use the following context about the user:
${JSON.stringify(context, null, 2)}
`

  const responseText = await callLLM({
    model: 'gpt-4.1-mini', // or your preferred model
    system: systemPrompt,
    user: prompt,
  })

  await db.aiConversation.create({
    data: {
      userId: user.id,
      prompt,
      response: responseText,
    },
  })

  return Response.json({ response: responseText })
}
